# @configure_input@
srcdir = @srcdir@
prefix = @prefix@
exec_prefix = @exec_prefix@
datarootdir = @datarootdir@

# Set default values if not provided by configure
libdir = @libdir@
includedir = @includedir@
mandir = @mandir@

# If still empty, use defaults
ifeq ($(libdir),)
libdir = $(exec_prefix)/lib
endif
ifeq ($(includedir),)
includedir = $(prefix)/include
endif
ifeq ($(mandir),)
mandir = $(datarootdir)/man
endif

VPATH = @srcdir@
CC=@CC@
AR = @AR@
RANLIB = @RANLIB@
LDFLAGS = @LDFLAGS@

# VOLK support
VOLK_CFLAGS = @VOLK_CFLAGS@
VOLK_LIBS = @VOLK_LIBS@

# Updated CFLAGS to include VOLK flags
CFLAGS=@CFLAGS@ -I. -fPIC -Wall -O3 -march=native -mtune=native -ffast-math -funroll-loops $(VOLK_CFLAGS)

LIBS_OBJ = @MLIBS@ fec.o sim.o \
	viterbi27_port.o viterbi29_port.o viterbi39_port.o viterbi615_port.o \
	encode_rs_char.o encode_rs_int.o encode_rs_8.o \
	decode_rs_char.o decode_rs_int.o decode_rs_8.o \
	init_rs_char.o init_rs_int.o \
	ccsds_tab.o encode_rs_ccsds.o decode_rs_ccsds.o ccsds_tal.o \
	dotprod_port.o peakval_port.o sumsq_port.o

SHARED_LIB=@SH_LIB@

all: libfec.a $(SHARED_LIB)

libfec.a: $(LIBS_OBJ)
	$(AR) rv $@ $^
	$(RANLIB) $@

# For Darwin (macOS) - include VOLK libs
libfec.dylib: $(LIBS_OBJ)
	$(CC) $(CFLAGS) $(LDFLAGS) -dynamiclib -install_name $(prefix)/lib/$@ -o $@ $^ $(VOLK_LIBS)

# For Linux et al - include VOLK libs
libfec.so: $(LIBS_OBJ)
	$(CC) $(CFLAGS) $(LDFLAGS) -shared -Xlinker -soname=$@ -o $@ -Wl,-whole-archive $^ -Wl,-no-whole-archive -lc $(VOLK_LIBS)

# Generic rule for compiling .c to .o from the source directory
# This will be used for most library object files if no specific rule exists.
%.o: $(srcdir)/%.c
	$(CC) $(CFLAGS) -c -o $@ $<

# Specific object file rules if they have unique dependencies or commands
# (Many might be covered by the generic rule above if their .c files are in $(srcdir)
# and they just need standard compilation)

# Example for a file that might be in current dir or has specific deps:
# sim.o: sim.c fec.h
#	$(CC) $(CFLAGS) -c -o $@ $<

# Test program object files
vtest27.o: vtest27.c fec.h
	$(CC) $(CFLAGS) -c -o $@ $<

vtest29.o: vtest29.c fec.h
	$(CC) $(CFLAGS) -c -o $@ $<

vtest39.o: vtest39.c fec.h
	$(CC) $(CFLAGS) -c -o $@ $<

vtest615.o: vtest615.c fec.h
	$(CC) $(CFLAGS) -c -o $@ $<

rstest.o: rstest.c fec.h exercise_rs.h
	$(CC) $(CFLAGS) -c -o $@ $<

rs_speedtest.o: rs_speedtest.c fec.h
	$(CC) $(CFLAGS) -c -o $@ $<

exercise_rs_char.o: exercise_rs_char.c exercise_rs.h exercise_rs_bc.h exercise.h
	$(CC) $(CFLAGS) -c -o $@ $<

exercise_rs_int.o: exercise_rs_int.c exercise_rs.h exercise_rs_bc.h exercise.h
	$(CC) $(CFLAGS) -c -o $@ $<

exercise_rs_8.o: exercise_rs_8.c exercise_rs.h exercise_rs_bc.h exercise.h
	$(CC) $(CFLAGS) -c -o $@ $<

exercise_rs_ccsds.o: exercise_rs_ccsds.c exercise_rs.h exercise_rs_bc.h exercise.h
	$(CC) $(CFLAGS) -c -o $@ $<

# CCSDS table generation
init_rs_char_local.o: init_rs_char_local.c
	$(CC) $(CFLAGS) -c -o $@ $<

ccsds_tab.c: gen_ccsds
	./gen_ccsds > $@

gen_ccsds: gen_ccsds.o init_rs_char_local.o
	$(CC) $(CFLAGS) $(LDFLAGS) -o $@ $^

ccsds_tal.c: gen_ccsds_tal
	./gen_ccsds_tal > $@

gen_ccsds_tal: gen_ccsds_tal.o
	$(CC) $(CFLAGS) $(LDFLAGS) -o $@ $^

# Test executables linking - add VOLK libs where needed
vtest27: vtest27.o libfec.a
	$(CC) $(CFLAGS) $(LDFLAGS) -o $@ $^ -lm $(VOLK_LIBS)

vtest29: vtest29.o libfec.a
	$(CC) $(CFLAGS) $(LDFLAGS) -o $@ $^ -lm $(VOLK_LIBS)

vtest39: vtest39.o libfec.a
	$(CC) $(CFLAGS) $(LDFLAGS) -o $@ $^ -lm $(VOLK_LIBS)

vtest615: vtest615.o libfec.a
	$(CC) $(CFLAGS) $(LDFLAGS) -o $@ $^ -lm $(VOLK_LIBS)

rstest: rstest.o exercise_rs_char.o exercise_rs_int.o exercise_rs_8.o exercise_rs_ccsds.o libfec.a
	$(CC) $(CFLAGS) $(LDFLAGS) -o $@ $^ $(VOLK_LIBS)

rs_speedtest: rs_speedtest.o libfec.a
	$(CC) $(CFLAGS) $(LDFLAGS) -o $@ $^ $(VOLK_LIBS)

profile_viterbi27: profile_viterbi27.o libfec.a
	$(CC) $(CFLAGS) $(LDFLAGS) -o $@ $^ -lm $(VOLK_LIBS)


test: vtest27 vtest29 vtest39 vtest615 rstest rs_speedtest
	@echo "Running tests..."
	@echo "Correctness tests:"
	./vtest27 -e 3.0 -n 1000 -v
	./vtest29 -e 2.5 -n 1000 -v
	./vtest39 -e 2.5 -n 1000 -v
	./vtest615 -e 1.0 -n 100 -v
	./rstest
	@echo "Speed tests:"
	./vtest27
	./vtest29
	./vtest39
	./vtest615
	./rs_speedtest
	@echo "Tests finished."

install: all
	mkdir -p $(DESTDIR)$(libdir)
	install -m 644 -p $(SHARED_LIB) libfec.a $(DESTDIR)$(libdir)/
#	(cd $(DESTDIR)$(libdir);ln -f -s $(SHARED_LIB) libfec.so)
	@REBIND@
	mkdir -p $(DESTDIR)$(includedir)
	install -m 644 -p fec.h $(DESTDIR)$(includedir)/
	mkdir -p $(DESTDIR)$(mandir)/man3
	install -m 644 -p $(srcdir)/simd-viterbi.3 $(srcdir)/rs.3 $(srcdir)/dsp.3 $(DESTDIR)$(mandir)/man3/

clean:
	rm -f *.o *.a $(SHARED_LIB) libfec.dylib libfec.so \
	vtest27 vtest29 vtest39 vtest615 rstest rs_speedtest profile_viterbi27 \
	gen_ccsds gen_ccsds_tal ccsds_tab.c ccsds_tal.c core
	rm -rf autom4te.cache

distclean: clean
	rm -f config.log config.cache config.status config.h Makefile TAGS tags